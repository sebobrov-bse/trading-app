# Автоопределение текстовых файлов
* text=auto

# Python и конфиги — LF
*.py text eol=lf
*.pyi text eol=lf
*.toml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.json text eol=lf
*.sh text eol=lf

# PowerShell — CRLF (родной для Windows)
*.ps1 text eol=crlf

# Бинарные — не трогать
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
*.db binary
*.sqlite binary